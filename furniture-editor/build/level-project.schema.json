{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstere.github.io/cartridge-strike/furniture-editor/build/level-project.schema.json",
  "title": "Cartridge Strike level project",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "projectId", "name", "mode", "game", "units", "rules", "ground", "architecture", "furniture", "gameplay", "navHints", "intent", "validation", "assets", "agentBrief"],
  "properties": {
    "format": {"const": "cartridge-strike-level-project"},
    "schemaVersion": {"const": 2},
    "projectId": {"type": "string", "pattern": "^lvl-[a-z0-9-]{4,60}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "createdAt": {"type": "string", "format": "date-time"},
    "editorVersion": {"type": "string"},
    "mode": {"enum": ["new-level", "edit-floor5"]},
    "game": {"type": "object", "required": ["repository", "version", "baseCommit", "compatibleWith"], "properties": {"repository": {"const": "capstere/cartridge-strike"}, "version": {"type": "string"}, "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "compatibleWith": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}}, "additionalProperties": false},
    "units": {"type": "object", "required": ["linear", "metricScaleVerified", "planAxes", "upAxis", "playerRadius", "actorRadius", "gridStep"], "properties": {"linear": {"const": "model-unit"}, "metricScaleVerified": {"const": false}, "planAxes": {"const": ["x", "z"]}, "upAxis": {"const": "y"}, "playerRadius": {"const": 0.22}, "actorRadius": {"const": 0.2}, "gridStep": {"const": 0.1}}, "additionalProperties": false},
    "rules": {"type": "object", "required": ["minDoorWidth", "minCorridorWidth", "doorWidthAppliesTo"], "properties": {"minDoorWidth": {"const": 1.1}, "minCorridorWidth": {"const": 2}, "doorWidthAppliesTo": {"enum": ["all", "new-and-edited"]}}, "additionalProperties": false},
    "ground": {"type": "object", "required": ["bounds", "wallHeightDefault", "floors"], "properties": {"bounds": {"$ref": "#/$defs/rect"}, "wallHeightDefault": {"type": "number", "minimum": 0.45, "maximum": 6}, "tape": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/floorTape"}}, "floorEdits": {"type": "object", "maxProperties": 1000, "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 200, "items": {"$ref": "#/$defs/point"}}}, "openedAreas": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}}, "floors": {"type": "array", "maxItems": 1000, "items": {"allOf": [{"$ref": "#/$defs/rect"}, {"type": "object", "required": ["id", "name", "role", "surface"], "properties": {"id": {"type": "string", "pattern": "^BYGG-G-[0-9]{1,5}$"}, "name": {"type": "string", "maxLength": 60}, "role": {"enum": ["room", "corridor"]}, "surface": {"enum": ["carpet", "vinyl", "office-carpet", "dark-tile", "dark-gloss-laminate", "dark-large-stone"]}}}]}}}, "additionalProperties": false},
    "architecture": {"type": "object", "required": ["schemaVersion", "edits", "added", "removed", "floors"], "properties": {"schemaVersion": {"const": 1}, "edits": {"type": "array", "maxItems": 5000}, "added": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/segment"}}, "removed": {"type": "array", "maxItems": 5000}, "floors": {"type": "array", "maxItems": 1000}, "posters": {"type": "array", "maxItems": 1000}, "treatments": {"type": "array", "maxItems": 1000}}},
    "furniture": {"type": "object", "required": ["placements", "added", "removed"], "properties": {"placements": {"type": "array", "maxItems": 10000}, "added": {"type": "array", "maxItems": 10000}, "removed": {"type": "array", "maxItems": 10000}}, "additionalProperties": false},
    "gameplay": {"type": "object", "required": ["mode", "counts", "spawns", "objectives"], "properties": {"mode": {"const": "classic"}, "counts": {"type": "object", "required": ["analysts", "counterAnalysts"], "properties": {"analysts": {"type": "integer", "minimum": 1, "maximum": 5}, "counterAnalysts": {"type": "integer", "minimum": 1, "maximum": 5}}, "additionalProperties": false}, "startElevators": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/startElevator"}}, "spawns": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/spawn"}}, "objectives": {"type": "object", "required": ["bomb", "rescue", "hostages"], "properties": {"bomb": {"type": ["object", "null"]}, "rescue": {"type": ["object", "null"]}, "hostages": {"type": "array", "maxItems": 2}}, "additionalProperties": false}}, "additionalProperties": false},
    "navHints": {"type": "array", "maxItems": 250},
    "floorFinishes": {"type": "object", "maxProperties": 1000, "additionalProperties": {"enum": ["carpet", "vinyl", "office-carpet", "dark-tile", "dark-gloss-laminate", "dark-large-stone"]}},
    "surfaceMaterials": {"type": "object", "maxProperties": 10000, "additionalProperties": {"enum": ["white-tile-gray-grout"]}},
    "surfaceColors": {"type": "object", "maxProperties": 10000, "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
    "environment": {"type":"object","required":["version","seed","collision","fixtures","background","displays","facade"],"properties":{"version":{"const":1},"seed":{"type":"integer","minimum":0,"maximum":4294967295},"collision":{"const":"none"},"fixtures":{"type":"array","maxItems":400},"background":{"type":"array","maxItems":700},"displays":{"type":"array","maxItems":200},"facade":{"type":"object","required":["color","outline","edges"]}},"additionalProperties":false},
    "intent": {"type": "object"},
    "validation": {"type": "object"},
    "assets": {"type": "object", "required": ["library", "local", "posters"], "properties": {"library": {"type": "array", "maxItems": 2000, "items": {"type": "string"}}, "local": {"type": "array", "maxItems": 49, "items": {"$ref": "#/$defs/modelAsset"}}, "posters": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/posterAsset"}}, "preview": {"type": "object"}}, "additionalProperties": false},
    "agentBrief": {"type": "object"},
    "legacyPatch": {"type": "object"},
    "migrationNotes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "rect": {"type": "object", "required": ["x0", "z0", "x1", "z1"], "properties": {"x0": {"type": "number", "minimum": -100, "maximum": 100}, "z0": {"type": "number", "minimum": -100, "maximum": 100}, "x1": {"type": "number", "minimum": -100, "maximum": 100}, "z1": {"type": "number", "minimum": -100, "maximum": 100}}},
    "point": {"type": "array", "prefixItems": [{"type": "number", "minimum": -100, "maximum": 100}, {"type": "number", "minimum": -100, "maximum": 100}], "items": false},
    "floorTape": {"type": "object", "required": ["id", "a", "b", "style", "color"], "properties": {"id": {"type": "string", "pattern": "^TEJP-[0-9]{4}$"}, "a": {"$ref": "#/$defs/point", "minItems": 2}, "b": {"$ref": "#/$defs/point", "minItems": 2}, "style": {"enum": ["solid", "hazard"]}, "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}, "additionalProperties": false},
    "segment": {"type": "object", "required": ["id", "kind", "a", "b", "height", "thickness", "sill"], "properties": {"id": {"type": "string", "pattern": "^BYGG-[VD]-[0-9]{1,5}$"}, "doorStyle": {"enum": ["solid", "frosted", "wc", "office"]}, "glazingStyle": {"enum": ["standard", "office-band"]}, "kind": {"enum": ["wall", "glazed", "window", "door", "card-door", "elevator-door", "terrace-door", "opening"]}, "a": {"$ref": "#/$defs/point"}, "b": {"$ref": "#/$defs/point"}, "height": {"type": "number", "minimum": 0.45, "maximum": 6}, "thickness": {"type": "number", "minimum": 0.025, "maximum": 0.7}, "sill": {"type": "number", "minimum": 0}}},
    "startElevator": {"type":"object","required":["team","doorId","floorId","lobbyId"],"properties":{"team":{"enum":["analysts","counterAnalysts"]},"doorId":{"type":"string","pattern":"^(D[0-9]{2}|BYGG-D-[0-9]{1,5})$"},"floorId":{"type":"string","pattern":"^BYGG-G-[0-9]{1,5}$"},"lobbyId":{"type":"string","pattern":"^I[0-9]{2}$"},"excludedAreaId":{"type":"string","pattern":"^X[0-9]{2}$"}},"additionalProperties":false},
    "spawn": {"type": "object", "required": ["id", "team", "index", "x", "z", "yaw"], "properties": {"id": {"type": "string", "pattern": "^SP-[AC]-[0-9]{2}$"}, "team": {"enum": ["analysts", "counterAnalysts"]}, "index": {"type": "integer", "minimum": 0, "maximum": 4}, "x": {"type": "number", "minimum": -100, "maximum": 100}, "z": {"type": "number", "minimum": -100, "maximum": 100}, "yaw": {"type": "number", "minimum": -3.142, "maximum": 3.142}}},
    "modelAsset": {"type": "object", "required": ["assetId", "file", "bytes"], "properties": {"assetId": {"type": "string", "pattern": "^local:[a-f0-9]{64}$"}, "file": {"type": "string", "pattern": "^assets/models/[a-f0-9]{64}\\.glb$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 20000000}, "license": {"type": "string"}}, "additionalProperties": false},
    "posterAsset": {"type": "object", "required": ["id", "file", "bytes", "sha256"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}, "file": {"type": "string", "pattern": "^assets/posters/[A-Za-z0-9_-]{1,64}\\.webp$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 5000000}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  }
}
